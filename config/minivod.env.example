# MiniVOD paths
MINIVOD_DB=/home/server/downloads/vod.db
MINIVOD_MEDIA=/home/server/downloads/iptv
MINIVOD_CACHE=/home/server/vod-cache

# HTTP local. Cloudflare Tunnel aponta para esta porta.
MINIVOD_HOST=127.0.0.1
MINIVOD_PORT=8079

# URL pública usada nas respostas Xtream/M3U.
# Exemplo: https://vod.seudominio.com
MINIVOD_BASE_URL=https://vod.example.com

# HLS
MINIVOD_SEGMENT_TIME=6
MINIVOD_PLAYLIST_WAIT=30
MINIVOD_MAX_FFMPEG_JOBS=2

# 0 = transcodifica codecs incompatíveis quando necessário
# 1 = somente remux/copy, sem transcode
MINIVOD_COPY_ONLY=0
